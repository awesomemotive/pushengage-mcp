{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "types": ["node", "jest"]
  },
  // Base config used by the editor and `npm run typecheck`. It includes the colocated *.test.ts
  // files so the language server resolves node + jest types for them. The build uses
  // tsconfig.build.json, which excludes tests so they are not emitted into dist/.
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}
